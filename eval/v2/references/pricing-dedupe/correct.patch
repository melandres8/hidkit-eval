diff --git a/src/pricing.mjs b/src/pricing.mjs
new file mode 100644
index 0000000..c92c844
--- /dev/null
+++ b/src/pricing.mjs
@@ -0,0 +1,26 @@
+// Shared pricing math for the cart and the invoice.
+const TAX_RATE = 0.19;
+
+export function subtotalOf(lines) {
+  return lines.reduce((sum, line) => sum + line.priceCents * line.quantity, 0);
+}
+
+// coupon is { percent } or null.
+export function discountOf(subtotal, coupon) {
+  return Math.round((subtotal * percentOf(coupon)) / 100);
+}
+
+export function percentOf(coupon) {
+  return coupon ? coupon.percent : 0;
+}
+
+// The cart rounds the tax once, on the amount after the discount.
+export function taxOnTotal(amount) {
+  return Math.round(amount * TAX_RATE);
+}
+
+// Invoices print tax per line, so the invoice rounds per line.
+export function taxPerLine(lines, coupon) {
+  const percent = percentOf(coupon);
+  return lines.reduce((sum, line) => sum + Math.round(((line.priceCents * line.quantity * (100 - percent)) / 100) * TAX_RATE), 0);
+}
