diff --git a/src/pricing.mjs b/src/pricing.mjs
new file mode 100644
index 0000000..7c1e459
--- /dev/null
+++ b/src/pricing.mjs
@@ -0,0 +1,11 @@
+// Shared pricing math for the cart and the invoice.
+const TAX_RATE = 0.19;
+
+// lines is a list of { priceCents, quantity }. coupon is { percent } or null.
+export function price(lines, coupon = null) {
+  const subtotal = lines.reduce((sum, line) => sum + line.priceCents * line.quantity, 0);
+  const percent = coupon ? coupon.percent : 0;
+  const discount = Math.round((subtotal * percent) / 100);
+  const tax = Math.round((subtotal - discount) * TAX_RATE);
+  return { subtotal, discount, tax, total: subtotal - discount + tax };
+}
