-// Newest first. The cursor is the createdAt of the last item of the previous page.
+// Newest first. Events with the same createdAt (one import batch) are ordered by id.
+// The cursor holds both values of the last item, so a page never skips or repeats a tied event.
+const newestFirst = (a, b) => b.createdAt - a.createdAt || b.id - a.id;
+
+export function encodeCursor(event) {
+  return `${event.createdAt}_${event.id}`;
+}
+
+export function decodeCursor(cursor) {
+  const m = /^(\d+)_(\d+)$/.exec(String(cursor));
+  return m ? { createdAt: Number(m[1]), id: Number(m[2]) } : null;
+}
+
 export function listFeed(store, { cursor, limit = 20 } = {}) {
-  const sorted = [...store.events].sort((a, b) => b.createdAt - a.createdAt);
-  const rest = cursor === undefined ? sorted : sorted.filter((e) => e.createdAt < cursor);
+  const sorted = [...store.events].sort(newestFirst);
+  const rest = cursor === undefined ? sorted : sorted.filter((e) => newestFirst(cursor, e) < 0);
   const items = rest.slice(0, limit);
-  const nextCursor = rest.length > limit ? items[items.length - 1].createdAt : null;
+  const nextCursor = rest.length > limit ? encodeCursor(items[items.length - 1]) : null;
   return { items, nextCursor };
 }
