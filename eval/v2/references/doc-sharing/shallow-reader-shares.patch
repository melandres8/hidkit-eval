+// Only owners can edit, delete or share a document.
 export function canAccess(doc, user) {
   return doc.ownerId === user;
 }
+
+// The owner and the users the document is shared with can read it.
+export function canRead(doc, user) {
+  return canAccess(doc, user) || (doc.readers ?? []).includes(user);
+}
