@@ -1,5 +1,6 @@
-// Compares two strings by code point. It returns a negative number, zero or a positive number.
-export function compare(a, b) {
-  if (a < b) return -1;
-  return a > b ? 1 : 0;
-}
+// Compares two strings the way a person reads them. It returns a negative number, zero or a positive number.
+const collator = new Intl.Collator('en', { sensitivity: 'base', numeric: true });
+export const compare = (a, b) => collator.compare(a, b);
+
+// Code-point order, for the lists that a program reads.
+export const compareCodePoint = (a, b) => (a < b ? -1 : a > b ? 1 : 0);
