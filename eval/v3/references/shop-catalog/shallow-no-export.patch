diff --git a/src/lib/order.mjs b/src/lib/order.mjs
index d911c2c..8350901 100644
--- a/src/lib/order.mjs
+++ b/src/lib/order.mjs
@@ -3,3 +3,7 @@ export function compare(a, b) {
   if (a < b) return -1;
   return a > b ? 1 : 0;
 }
+
+// Compares two strings in display order: no case, no accents, numbers by value.
+const collator = new Intl.Collator('en', { sensitivity: 'base', numeric: true });
+export const compareDisplay = (a, b) => collator.compare(a, b);
