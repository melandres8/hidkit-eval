diff --git a/b/src/schedule/resolve.mjs b/src/schedule/resolve.mjs
new file mode 100644
index 0000000..9cdd94c
--- /dev/null
+++ b/src/schedule/resolve.mjs
@@ -0,0 +1,24 @@
+import { offsetAt } from './zone.mjs';
+
+const MINUTE_MS = 60 * 1000;
+const DAY_MS = 24 * 60 * MINUTE_MS;
+
+// Finds the instant of a wall-clock time in a zone. The fields are year, month (1 to 12), day, hour and minute.
+// A time that happens twice gives the first one. A time that does not exist gives the end of the gap.
+export function resolveLocal({ year, month, day, hour, minute }, zone) {
+  const wall = Date.UTC(year, month - 1, day, hour, minute);
+  // The offsets one day before and one day after bound every change that can touch this wall time.
+  const offsets = [...new Set([offsetAt(wall - DAY_MS, zone), offsetAt(wall + DAY_MS, zone)])];
+  const instants = offsets.map((offset) => wall - offset);
+  const valid = instants.filter((instant) => offsetAt(instant, zone) === wall - instant).sort((a, b) => a - b);
+  if (valid.length > 0) return valid[0];
+  // The wall time is in a gap. Search the minute where the new offset starts.
+  let low = Math.min(...instants);
+  let high = Math.max(...instants);
+  while (high - low > MINUTE_MS) {
+    const middle = low + Math.floor((high - low) / 2 / MINUTE_MS) * MINUTE_MS;
+    if (offsetAt(middle, zone) === offsetAt(high, zone)) high = middle;
+    else low = middle;
+  }
+  return high;
+}
