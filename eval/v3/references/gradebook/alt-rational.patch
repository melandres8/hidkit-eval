@@ -1,12 +1,19 @@
 import { conflict } from '../http/errors.mjs';
 
-// The points and the maximum of each category of a term, for one student.
+// The points and the maximum of each category that counts, for one student. See docs/grading.md.
+// An excused score does not count. A category whose scores are all excused does not count.
+// A category with no score yet means that the grade is not ready.
 export function categoryTotals(term, student) {
-  return term.categories.map(({ name, weight }) => {
+  const totals = [];
+  for (const { name, weight } of term.categories) {
     const scores = student.scores.filter((s) => s.category === name);
     if (scores.length === 0) throw conflict(`no score yet in ${name}`);
-    const points = scores.reduce((sum, s) => sum + s.points, 0);
-    const max = scores.reduce((sum, s) => sum + s.max, 0);
-    return { name, weight, points, max };
-  });
+    const counted = scores.filter((s) => !s.excused);
+    if (counted.length === 0) continue;
+    const points = counted.reduce((sum, s) => sum + s.points, 0);
+    const max = counted.reduce((sum, s) => sum + s.max, 0);
+    totals.push({ name, weight, points, max });
+  }
+  if (totals.length === 0) throw conflict('every score is excused');
+  return totals;
 }
