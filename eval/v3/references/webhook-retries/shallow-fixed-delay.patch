diff --git a/b/src/jobs/retry-deliveries.mjs b/src/jobs/retry-deliveries.mjs
new file mode 100644
index 0000000..12c7d19
--- /dev/null
+++ b/src/jobs/retry-deliveries.mjs
@@ -0,0 +1,13 @@
+import { deliver } from '../delivery/send.mjs';
+
+// Sends each delivery whose next attempt is due. A delivery of a removed subscription stops.
+export async function retryDeliveries(ctx) {
+  const now = ctx.clock().getTime();
+  for (const delivery of ctx.deliveries.due(now)) {
+    if (!ctx.subscriptions.get(delivery.subscriptionId)) {
+      ctx.deliveries.update(delivery.id, { status: 'cancelled', nextAttemptAt: null });
+      continue;
+    }
+    await deliver(ctx, delivery);
+  }
+}
