diff --git a/src/delivery/send.mjs b/src/delivery/send.mjs
index ad601c2..19ab72b 100644
--- a/src/delivery/send.mjs
+++ b/src/delivery/send.mjs
@@ -1,18 +1,32 @@
 import { buildRequest } from './request.mjs';
 
-// Sends one delivery once and records the result.
+export const MAX_ATTEMPTS = 5;
+const BASE_DELAY_MS = 1000;
+
+// A network error has status 0. Only these failures are worth another attempt.
+const retryable = (status) => status === 0 || status === 429 || status >= 500;
+
+// Sends one delivery once, records the result and plans the next attempt.
 export async function deliver(ctx, delivery) {
   const event = ctx.events.get(delivery.eventId);
   let status = 0;
   try {
-    ({ status } = await ctx.transport.send(buildRequest(ctx, delivery, event)));
+    ({ status } = await ctx.transport.send(buildRequest(delivery, event)));
   } catch {
     status = 0;
   }
-  const ok = status >= 200 && status < 300;
-  return ctx.deliveries.update(delivery.id, {
-    attempts: delivery.attempts + 1,
-    lastStatus: status,
-    status: ok ? 'delivered' : 'failed',
-  });
+  const attempts = delivery.attempts + 1;
+  const changes = { attempts, lastStatus: status, nextAttemptAt: null };
+  if (status >= 200 && status < 300) {
+    changes.status = 'delivered';
+  } else if (!delivery.retry || !retryable(status)) {
+    changes.status = 'failed';
+  } else if (attempts >= MAX_ATTEMPTS) {
+    changes.status = 'dead';
+    ctx.deadLetters.add({ deliveryId: delivery.id, eventId: delivery.eventId, url: delivery.url, attempts });
+  } else {
+    changes.status = 'retrying';
+    changes.nextAttemptAt = ctx.clock().getTime() + BASE_DELAY_MS;
+  }
+  return ctx.deliveries.update(delivery.id, changes);
 }
