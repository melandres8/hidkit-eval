diff --git a/b/src/services/refunds.mjs b/src/services/refunds.mjs
new file mode 100644
index 0000000..3b4c236
--- /dev/null
+++ b/src/services/refunds.mjs
@@ -0,0 +1,20 @@
+import { badRequest, conflict } from '../http/errors.mjs';
+import { parseAmount } from '../money/format.mjs';
+import { paymentPayload } from '../webhooks/payloads.mjs';
+import { getPayment } from './payments.mjs';
+
+export function refundPayment(ctx, id, { amount }) {
+  const payment = getPayment(ctx, id);
+  let minor;
+  try {
+    minor = parseAmount(amount, payment.currency);
+  } catch {
+    throw badRequest('invalid amount');
+  }
+  if (minor <= 0) throw badRequest('amount must be positive');
+  if (minor > payment.capturedAmount - payment.refundedAmount) throw conflict('refund is more than what is left');
+  payment.refundedAmount += minor;
+  ctx.ledger.record({ type: 'refund', paymentId: payment.id, currency: payment.currency, amount: -minor });
+  ctx.emitter.emit('payment.refunded', { ...paymentPayload(payment), refund: minor });
+  return payment;
+}
