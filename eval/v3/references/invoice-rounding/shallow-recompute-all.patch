@@ -1,4 +1,9 @@
 // Tax on an amount for a rate in basis points, in minor units.
+// It rounds half to even (docs/billing.md). All the math is in integers.
 export function taxOn(amountMinor, rateBps) {
-  return Math.round((amountMinor * rateBps) / 10000);
+  const scaled = amountMinor * rateBps;
+  const whole = Math.floor(scaled / 10000);
+  const rest = scaled % 10000;
+  if (rest * 2 === 10000) return whole % 2 === 0 ? whole : whole + 1;
+  return rest * 2 > 10000 ? whole + 1 : whole;
 }
