diff --git a/src/rollup/mean.mjs b/src/rollup/mean.mjs
index cdc7caa..6005151 100644
--- a/src/rollup/mean.mjs
+++ b/src/rollup/mean.mjs
@@ -1,4 +1,8 @@
 // The mean of a sum and a count, as a whole number of hundredths.
-export const meanOf = (sum, count) => Math.round(sum / count);
+// A tie goes away from zero. The sum and the count are whole numbers, so the arithmetic is exact.
+export const meanOf = (sum, count) => {
+  const magnitude = Math.floor((2 * Math.abs(sum) + count) / (2 * count));
+  return sum < 0 && magnitude !== 0 ? -magnitude : magnitude;
+};
 
 export const sumOf = (readings) => readings.reduce((total, r) => total + r.hundredths, 0);
