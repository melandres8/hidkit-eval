diff --git a/src/lib/client-key.mjs b/src/lib/client-key.mjs
index 2d2a99c..0460c71 100644
--- a/src/lib/client-key.mjs
+++ b/src/lib/client-key.mjs
@@ -1,4 +1,19 @@
-// The key of the caller. The limiters, the blocklist and the audit log use it.
-export function clientKey(request) {
-  return request.remoteAddress;
+import { ipToInt, matchesAny } from './cidr.mjs';
+
+// The key of the caller. It follows docs/proxy.md.
+export function clientKey(request, config) {
+  const remote = request.remoteAddress;
+  const trusted = config.trustedProxies ?? [];
+  if (!matchesAny(remote, trusted)) return remote;
+  const chain = String(request.headers?.['x-forwarded-for'] ?? '').split(',').map((entry) => entry.trim()).filter(Boolean);
+  for (let i = chain.length - 1; i >= 0; i -= 1) {
+    if (matchesAny(chain[i], trusted)) continue;
+    return ipToInt(chain[i]) === null ? remote : chain[i];
+  }
+  return remote;
+}
+
+// The key of the rate limiters. A signed-in user has a key. An anonymous client has the key of its address.
+export function rateLimitKey(request, config) {
+  return request.user ? `user:${request.user.id}` : `ip:${clientKey(request, config)}`;
 }
