diff --git a/src/config/get.mjs b/src/config/get.mjs
index 7173716..8bec49b 100644
--- a/src/config/get.mjs
+++ b/src/config/get.mjs
@@ -9,3 +9,13 @@ export function set(object, path, value) {
   const target = parts.reduce((node, part) => (node[part] = node[part] ?? {}), object);
   target[last] = value;
 }
+
+// Removes a key. An empty parent object goes with it.
+export function unset(object, path) {
+  const parts = path.split('.');
+  const last = parts.pop();
+  const parent = parts.length ? get(object, parts.join('.')) : object;
+  if (parent === null || typeof parent !== 'object') return;
+  delete parent[last];
+  if (parts.length && Object.keys(parent).length === 0) unset(object, parts.join('.'));
+}
