diff --git a/b/src/config/deprecated.mjs b/src/config/deprecated.mjs
new file mode 100644
index 0000000..c1954c6
--- /dev/null
+++ b/src/config/deprecated.mjs
@@ -0,0 +1,22 @@
+import { get, set, unset } from './get.mjs';
+
+// Keys that a release renamed. The old key keeps working. See docs/config.md.
+export const RENAMED = {
+  'db.url': 'database.connectionString',
+};
+
+// Moves the value of each old key to its new key and warns once for each old key. Changes the object.
+export function applyRenames(raw, warn) {
+  for (const [oldKey, newKey] of Object.entries(RENAMED)) {
+    const value = get(raw, oldKey);
+    if (value === undefined) continue;
+    if (get(raw, newKey) === undefined) {
+      warn(`config key "${oldKey}" is deprecated. Use "${newKey}".`);
+    } else {
+      warn(`config key "${oldKey}" is deprecated and "${newKey}" is also set. The value of "${newKey}" wins.`);
+    }
+    set(raw, newKey, value);
+    unset(raw, oldKey);
+  }
+  return raw;
+}
