diff --git a/b/src/jobs/purge-deleted.mjs b/src/jobs/purge-deleted.mjs
new file mode 100644
index 0000000..8fedd4b
--- /dev/null
+++ b/src/jobs/purge-deleted.mjs
@@ -0,0 +1,10 @@
+import { RETENTION_MS } from '../lib/retention.mjs';
+import { isDeleted } from '../store/users.mjs';
+
+// Removes the records of users who were deleted more than 30 days ago.
+export function runPurge({ store, clock }) {
+  const limit = clock().getTime() - RETENTION_MS;
+  const expired = store.all().filter((user) => isDeleted(user) && Date.parse(user.deletedAt) < limit);
+  for (const user of expired) store.remove(user.id);
+  return { removed: expired.length };
+}
