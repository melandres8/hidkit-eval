diff --git a/b/src/jobs/purge-deleted.mjs b/src/jobs/purge-deleted.mjs
new file mode 100644
index 0000000..bcd974c
--- /dev/null
+++ b/src/jobs/purge-deleted.mjs
@@ -0,0 +1,7 @@
+// Removes the records of users who were deleted more than 30 days ago.
+export function runPurge({ store, clock }) {
+  const limit = clock().getTime() - 30 * 24 * 60 * 60 * 1000;
+  const expired = store.deleted().filter((user) => Date.parse(user.deletedAt) < limit);
+  for (const user of expired) store.purge(user.id);
+  return { removed: expired.length };
+}
